---
// Homepage intro: art history rendered as terminal characters, from the Creation of Adam to AI art.
// Plays once per browser (or with ?intro), then hands control back to the terminal homepage.
import type { Lang } from '../i18n';
import { HINT, SCENES } from '../scripts/genesis/timeline';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div id="genesis" class="genesis" hidden data-lang={lang} role="region" aria-label="intro">
  <canvas class="g-canvas" aria-hidden="true"></canvas>
  <div class="g-shade" aria-hidden="true"></div>
  <div class="g-cursor" aria-hidden="true">
    <div class="g-mark"><span class="g-gt">&gt;</span><span class="g-us">_</span><span class="g-type"></span></div>
  </div>
  <div class="g-cap" aria-hidden="true">
    <div class="g-l1"><span class="g-title"></span></div>
    <div class="g-l2"></div>
    <div class="g-status"></div>
  </div>
  <ol class="g-rail" aria-hidden="true">
    <i class="g-rail-fill"></i>
    {SCENES.map((s) => <li>{s.year}</li>)}
  </ol>
  <div class="g-progress" aria-hidden="true"><i></i></div>
  <div class="g-hint">{HINT[lang]}</div>
  <button type="button" class="g-skip">skip <kbd>esc</kbd></button>
</div>

<style is:global>
  html.genesis-pending,
  html.genesis-pending body {
    overflow: hidden;
  }
  html.genesis-pending header.site,
  html.genesis-pending main,
  html.genesis-pending footer.site {
    visibility: hidden;
  }

  .genesis {
    --g-bg: #050706;
    --g-fg: #d6dbd4;
    --g-amber: #f2b33d;
    --g-green: #7bd88f;
    --g-cyan: #6cc4d9;
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: visible;
    background: var(--g-bg);
    color: var(--g-fg);
    font-family: var(--mono);
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: opacity 0.6s ease;
  }
  .genesis[hidden] {
    display: none;
  }
  .g-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.8s ease;
  }
  .genesis.closing .g-canvas,
  .genesis.closing .g-cap,
  .genesis.closing .g-rail,
  .genesis.closing .g-progress,
  .genesis.closing .g-hint,
  .genesis.closing .g-skip {
    opacity: 0 !important;
    transition: opacity 0.6s ease;
  }
  .genesis.closing {
    background: transparent;
    transition: background 0.8s ease, opacity 0.6s ease;
    pointer-events: none;
  }

  /* Legibility for the captions at the bottom. */
  .g-shade {
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    /* Holds its darkness behind the caption block: a painting written in letters is busy there. */
    background: linear-gradient(to top, rgba(5, 7, 6, 0.94), rgba(5, 7, 6, 0.82) 38%, rgba(5, 7, 6, 0));
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .genesis.running .g-shade {
    opacity: 1;
  }

  /* ── the ever-present >_ ── */
  .g-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
    will-change: transform;
  }
  .g-cursor.fly {
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .g-mark {
    position: absolute;
    display: flex;
    align-items: baseline;
    /* ">_" is two monospace cells wide: centre on them, let typed text run to the right.
       --g-s swells the mark at the end of the film, about the point the cursor stands on. */
    transform: translate(-0.6em, -50%) scale(var(--g-s, 1));
    transform-origin: 0.6em 50%;
    font-size: clamp(18px, 1.6vw, 28px);
    font-weight: 600;
    line-height: 1;
    white-space: pre;
    color: #f1fbef;
    text-shadow:
      0 0 2px #000,
      0 0 8px rgba(0, 0, 0, 0.95),
      0 0 22px rgba(123, 216, 143, 0.8);
  }
  .g-us {
    color: var(--g-amber);
    animation: g-blink 1.05s steps(1) infinite;
  }
  .g-type {
    font-weight: 400;
    font-size: 0.72em;
    color: var(--g-fg);
    text-shadow:
      0 0 2px #000,
      0 0 8px rgba(0, 0, 0, 0.9);
  }
  @keyframes g-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── captions ── */
  .g-cap {
    position: absolute;
    left: max(16px, 3vw);
    bottom: max(18px, 4vh);
    max-width: min(46rem, calc(100vw - 32px));
    font-size: clamp(12px, 0.95vw, 15px);
    line-height: 1.7;
    text-shadow: 0 0 6px #000;
    pointer-events: none;
  }
  .g-l1 {
    color: #f3f5f1;
  }
  .g-l1 {
    font-size: 1.15em;
  }
  .g-l2 {
    color: #aab3ab;
    min-height: 1.7em;
  }
  .g-status {
    color: var(--g-cyan);
    min-height: 1.7em;
  }

  /* ── timeline rail ── */
  .g-rail {
    position: absolute;
    right: max(14px, 2vw);
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0 0 14px;
    list-style: none;
    font-size: 11px;
    line-height: 2.3;
    color: rgba(214, 219, 212, 0.38);
    text-align: right;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .genesis.running .g-rail {
    opacity: 1;
  }
  .g-rail::before,
  .g-rail-fill {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    bottom: 0.6em;
    width: 1px;
    background: rgba(214, 219, 212, 0.18);
  }
  .g-rail-fill {
    background: var(--g-amber);
    transform-origin: top;
    transform: scaleY(0);
  }
  .g-rail li {
    cursor: pointer;
    pointer-events: auto;
    transition: color 0.3s;
  }
  .g-rail li:hover {
    color: var(--g-fg);
  }
  .g-rail li.on {
    color: var(--g-amber);
  }
  .g-rail li.on::after {
    content: ' ◂';
  }
  .g-progress {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: rgba(214, 219, 212, 0.12);
  }
  .g-progress i {
    display: block;
    height: 100%;
    background: var(--g-amber);
    transform-origin: left;
    transform: scaleX(0);
  }
  @media (max-width: 700px) {
    .g-rail {
      display: none;
    }
    .g-progress {
      display: block;
    }
  }

  .g-hint {
    position: absolute;
    left: 50%;
    top: max(16px, 3vh);
    transform: translateX(-50%);
    font-size: 12px;
    color: rgba(214, 219, 212, 0.55);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .genesis.running .g-hint {
    opacity: 1;
  }
  .genesis .g-hint.gone {
    opacity: 0;
  }
  .g-skip {
    position: absolute;
    right: max(14px, 2vw);
    top: max(12px, 2.4vh);
    font: inherit;
    font-size: 12px;
    color: rgba(214, 219, 212, 0.6);
    background: rgba(5, 7, 6, 0.55);
    border: 1px solid rgba(214, 219, 212, 0.2);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }
  .g-skip:hover {
    color: var(--g-amber);
    border-color: var(--g-amber);
  }
  .g-skip kbd {
    font: inherit;
    opacity: 0.6;
  }
  /* After the base rules above: the same selectors earlier in the sheet would lose to them. */
  @media (max-width: 700px) {
    .g-hint {
      left: 16px;
      transform: none;
      white-space: normal;
      max-width: calc(100% - 120px);
      font-size: 11px;
    }
  }
  @media (pointer: coarse) {
    .g-skip kbd {
      display: none;
    }
  }

  /* ── hand-off: the homepage prints itself ── */
  .g-pre {
    opacity: 0;
    transform: translateY(4px);
  }
  .g-pre.g-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
</style>

<script>
  import { boot } from '../scripts/genesis/main';
  boot();
</script>
