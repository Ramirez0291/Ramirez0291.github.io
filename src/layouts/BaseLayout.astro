---
import '../styles/global.css';
import { DEFAULT_LANG, HTML_LANG, LANGS, OG_LOCALE, SECTIONS, localePath, ui, type Lang } from '../i18n';
import { AUTHOR, OG_IMAGE, siteSchema } from '../seo';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // URL of this same page in each language; a missing entry means no counterpart exists.
  alternates?: Partial<Record<Lang, string>>;
  // Post pages only: marks the page as an article and dates it for search engines.
  article?: { published: Date; modified: Date; section: string; tags: string[] };
  // schema.org nodes describing this page, added to the site-wide WebSite and Person.
  schema?: object[];
  // Plain Markdown copy of this page for agents.
  markdown?: string;
  // Keeps the page out of search indexes, e.g. the 404 page.
  noindex?: boolean;
}

const { lang, title, description, alternates = {}, article, schema = [], markdown, noindex = false } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} | ${t.siteName}` : `${t.siteName} — ${t.tagline}`;
const pageDescription = description ?? t.tagline;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const translations = Object.entries(alternates) as [Lang, string][];
// Readers whose language matches neither version get the Chinese original.
const xDefault = translations.length > 1 ? alternates[DEFAULT_LANG] : undefined;
// Escape "<" so text inside the data can never close the script element early.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...siteSchema(lang), ...schema] }).replace(
  /</g,
  '\\u003c',
);
// The prompt's working directory mirrors the URL, minus the language prefix.
const cwd = '~' + (lang === DEFAULT_LANG ? path : path.slice(lang.length + 1)).replace(/\/$/, '');

const navItems = SECTIONS.map((key) => ({
  key,
  href: localePath(lang, `/${key}/`),
}));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={AUTHOR.name} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
          <link rel="canonical" href={canonical} />
          <meta property="og:url" content={canonical} />
          {translations.map(([l, href]) => (
            <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(href, Astro.site)} />
          ))}
          {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
        </>
      )
    }
    {markdown && <link rel="alternate" type="text/markdown" title={title} href={markdown} />}
    <link rel="alternate" type="application/rss+xml" title={t.siteName} href={localePath(lang, '/rss.xml')} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title ?? t.siteName} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      translations
        .filter(([l]) => l !== lang)
        .map(([l]) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)
    }
    <meta property="og:image" content={new URL(OG_IMAGE.path, Astro.site)} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.modified.toISOString()} />
          <meta property="article:author" content={new URL(localePath(lang, '/about/'), Astro.site)} />
          <meta property="article:section" content={article.section} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={AUTHOR.twitter} />
    <meta name="twitter:creator" content={AUTHOR.twitter} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <meta name="theme-color" content="#0c0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f1e8" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <span class="ps1"><a href={localePath(lang, '/')}>rami0291@tokyo</a>:<span class="cwd">{cwd}</span>$</span>
        <nav aria-label={t.navLabel}>
          {
            navItems.map((item) => (
              <a href={item.href} title={t.nav[item.key]} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.key === 'about' ? 'about' : `${item.key}/`}
              </a>
            ))
          }
        </nav>
        <span class="lang-switch">
          [{
            LANGS.map((l, i) => (
              <>
                {i > 0 && '|'}
                {l === lang ? (
                  <span class="on">{l}</span>
                ) : (
                  <a href={alternates[l] ?? localePath(l, '/')} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]}>
                    {l}
                  </a>
                )}
              </>
            ))
          }]
        </span>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">{t.footer}</div>
    </footer>
  </body>
</html>
