---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Genesis from '../../components/Genesis.astro';
import { DEFAULT_LANG, PREFERRED_LANG_JS, getPosts, localeAlternates, localeParams, localePath, postUrl, SERIES, ui, type Lang } from '../../i18n';
import { STATUS, TOOLS } from '../../tools';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
const featured = posts.filter((p) => p.data.featured);
const latest = posts.slice(0, 5);
const series = Object.entries(SERIES).filter(([key]) => posts.some((p) => p.data.series === key));
---

<BaseLayout lang={lang} alternates={localeAlternates('/')}>
  <Fragment slot="head">
    {
      /* The root homepage sends readers on to /en/ or /ja/ when their browser asks for that language
         (or they picked it before). Only here: other pages keep their URL so shared links and search
         results open as they were, and offer a translation instead. Crawlers are left alone, so the
         Chinese homepage stays indexed. Anything else, or nothing, stays on Chinese. */
      lang === DEFAULT_LANG && (
        <script
          is:inline
          set:html={`(function () {
  if (/bot|crawl|spider|slurp|preview|lighthouse|headless/i.test(navigator.userAgent)) return;
  var pref = (${PREFERRED_LANG_JS})();
  if (!pref || pref.lang === ${JSON.stringify(DEFAULT_LANG)}) return;
  var target = '/' + pref.lang + '/';
  if (location.pathname === '/') location.replace(target + location.search + location.hash);
})();`}
        />
      )
    }
    {/* Decide before first paint whether the intro plays, so the homepage never flashes underneath. */}
    <script is:inline>
      (function () {
        try {
          var force = new URLSearchParams(location.search).has('intro');
          var seen = false;
          try { seen = localStorage.getItem('genesis-seen') === '1'; } catch (e) {}
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if ((force || !seen) && !calm && window.WebGL2RenderingContext) {
            var html = document.documentElement;
            html.classList.add('genesis-pending');
            // Safety net: if the intro script never starts, show the page anyway.
            setTimeout(function () { if (!window.__genesis) html.classList.remove('genesis-pending'); }, 6000);
          }
        } catch (e) {}
      })();
    </script>
  </Fragment>
  <Genesis lang={lang} />
  <div class="cmd"><b>whoami</b></div>
  <div class="out">
    <h1>Rami0291</h1>
    <p class="dim" style="margin:0">{t.tagline}</p>
    {t.whoami.map((line) => <p style="margin:0.2rem 0 0">{line}</p>)}
    <p class="meta"><a href={localePath(lang, '/about/')}>cat about.md →</a></p>
  </div>

  {
    featured.length > 0 && (
      <>
        <div class="cmd">
          <b>ls</b> ./featured
        </div>
        <div class="boxes">
          {featured.map((post) => (
            <a class="box" href={postUrl(post)}>
              <span class="label">{post.data.category}/</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }

  <div class="cmd"><b>ls -t</b> ./posts | head -5</div>
  <PostList posts={latest} lang={lang} />

  <div class="cmd"><b>ls</b> ./lab</div>
  <div class="boxes">
    {
      TOOLS.map((tool) => (
        <a class="box" href={tool.ready ? tool.href : localePath(lang, '/lab/')}>
          <span class="label">[{tool.id}]</span>
          <h3>
            {tool.name[lang]} <span class="status">{STATUS[tool.ready ? 'ready' : 'building'][lang]}</span>
          </h3>
          <p>{tool.desc[lang]}</p>
        </a>
      ))
    }
  </div>

  {
    series.length > 0 && (
      <>
        <div class="cmd">
          <b>ls</b> ./series
        </div>
        <ul class="ls">
          {series.map(([key, names]) => (
            <li>
              <span class="perm">series/</span>
              <a class="title" href={localePath(lang, `/series/${key}/`)}>
                {names[lang]}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="cmd"><a href={localePath(lang, '/') + '?intro'}><b>./genesis.sh</b> --replay</a></div>

  <div class="cmd"><span class="cursor" aria-hidden="true"></span></div>
</BaseLayout>
