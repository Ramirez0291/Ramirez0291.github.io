---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localeParams, localePath, ui, type Lang } from '../../../i18n';
import { Content as AboutZh } from '../../../about/zh.md';
import { Content as AboutJa } from '../../../about/ja.md';
import { AUTHOR, profileSchema } from '../../../seo';

export const getStaticPaths = localeParams;

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const About = lang === 'zh' ? AboutZh : AboutJa;
---

<BaseLayout
  lang={lang}
  title={t.nav.about}
  description={t.navDesc.about}
  alternates={{ zh: localePath('zh', '/about/'), ja: localePath('ja', '/about/') }}
  schema={profileSchema(lang)}
>
  <div class="cmd"><b>cat</b> about.md</div>
  <h1>Who am I?</h1>
  {
    lang === 'ja' && (
      <p class="notice">
        <span class="lvl">[INFO]</span>
        {t.machineTranslated} <a href={localePath('zh', '/about/')}>{t.readOriginal}</a>
      </p>
    )
  }
  <div class="prose">
    <About />
  </div>

  <div class="cmd"><b>cat</b> contact.txt</div>
  <ul class="ls">
    {
      AUTHOR.links.map((link) => (
        <li>
          <span class="perm">{link.label}</span>
          <a class="title" href={link.href} rel="me">
            {link.handle}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
