---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { CATEGORIES, getPosts, localeParams, localePath, ui, type Category, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return localeParams().flatMap(({ params, props }) =>
    CATEGORIES.map((category) => ({ params: { ...params, category }, props: { ...props, category } })),
  );
}

const { lang, category } = Astro.props as { lang: Lang; category: Category };
const t = ui[lang];
const posts = await getPosts(lang, (p) => p.data.category === category);
---

<BaseLayout
  lang={lang}
  title={t.nav[category]}
  description={t.navDesc[category]}
  alternates={{ zh: localePath('zh', `/${category}/`), ja: localePath('ja', `/${category}/`) }}
>
  <div class="cmd"><b>ls -t</b> ./{category}</div>
  <h1>{t.nav[category]}</h1>
  <p class="meta">total {posts.length}</p>
  <PostList posts={posts} lang={lang} showCategory={false} />
</BaseLayout>
