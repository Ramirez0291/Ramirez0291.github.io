---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  DEFAULT_LANG,
  formatDate,
  localePath,
  postLang,
  postSlug,
  postUrl,
  SERIES,
  ui,
  type Lang,
  type Post,
} from '../../../i18n';

export async function getStaticPaths() {
  const posts: Post[] = await getCollection('posts', (p: Post) => !p.data.draft);
  return posts.map((post) => {
    const lang = postLang(post);
    const slug = postSlug(post);
    const counterpart = posts.find((p) => postSlug(p) === slug && postLang(p) !== lang);
    return {
      params: {
        locale: lang === DEFAULT_LANG ? undefined : lang,
        category: post.data.category,
        slug,
      },
      props: { post, lang, counterpart },
    };
  });
}

const { post, lang, counterpart } = Astro.props as { post: Post; lang: Lang; counterpart?: Post };
const t = ui[lang];
const { Content } = await render(post);
const { title, description, date, updated, lastVerified, machineTranslated, series, category } = post.data;

const alternates: Partial<Record<Lang, string>> = { [lang]: postUrl(post) };
if (counterpart) alternates[postLang(counterpart)] = postUrl(counterpart);
---

<BaseLayout lang={lang} title={title} description={description} alternates={alternates}>
  <article>
    <div class="cmd"><b>cat</b> {category}/{postSlug(post)}.md</div>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      {updated && <> · {t.updated} {formatDate(updated, lang)}</>}
      {
        lastVerified && (
          <>
            {' · '}
            {t.lastVerified} <time datetime={lastVerified.toISOString()}>{formatDate(lastVerified, lang)}</time>{' '}
            <span class="ok">✓</span>
          </>
        )
      }
      {
        series && SERIES[series] && (
          <>
            {' · '}
            <a href={localePath(lang, `/series/${series}/`)}>{SERIES[series][lang]}</a>
          </>
        )
      }
    </div>

    {
      machineTranslated && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          {t.machineTranslated}
          {counterpart && (
            <>
              {' '}
              <a href={postUrl(counterpart)}>{t.readOriginal}</a>
            </>
          )}
        </p>
      )
    }
    {
      !machineTranslated && counterpart && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          <a href={postUrl(counterpart)} hreflang="ja">
            {t.readTranslation}
          </a>
        </p>
      )
    }
    {
      lastVerified && (
        <p class="notice warn" hidden data-stale-check={lastVerified.toISOString()}>
          <span class="lvl">[WARN]</span>
          {t.staleWarning}
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  // Staleness is judged against the reader's clock, not the build date,
  // so the warning still appears on a static page nobody has rebuilt for months.
  const STALE_AFTER_DAYS = 180;
  document.querySelectorAll<HTMLElement>('[data-stale-check]').forEach((el) => {
    const verified = new Date(el.dataset.staleCheck!).getTime();
    const ageDays = (Date.now() - verified) / 86_400_000;
    if (ageDays > STALE_AFTER_DAYS) el.hidden = false;
  });
</script>
