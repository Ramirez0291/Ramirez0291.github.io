---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comments from '../../../components/Comments.astro';
import {
  findCounterpart,
  formatDate,
  getAllPosts,
  localePath,
  postLang,
  postMarkdownUrl,
  postModified,
  postParams,
  postSlug,
  postUrl,
  SERIES,
  ui,
  type Lang,
  type Post,
} from '../../../i18n';
import { postSchema } from '../../../seo';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: postParams(post),
    props: { post, lang: postLang(post), counterpart: findCounterpart(post, posts) },
  }));
}

const { post, lang, counterpart } = Astro.props as { post: Post; lang: Lang; counterpart?: Post };
const t = ui[lang];
const { Content } = await render(post);
const { title, description, date, updated, lastVerified, machineTranslated, series, category, tags } = post.data;

const alternates: Partial<Record<Lang, string>> = { [lang]: postUrl(post) };
if (counterpart) alternates[postLang(counterpart)] = postUrl(counterpart);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
  article={{ published: date, modified: postModified(post), section: t.nav[category], tags }}
  schema={postSchema(post, counterpart)}
  markdown={postMarkdownUrl(post)}
>
  <article>
    <div class="cmd"><b>cat</b> {category}/{postSlug(post)}.md</div>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      {updated && <> · {t.updated} {formatDate(updated, lang)}</>}
      {
        lastVerified && (
          <>
            {' · '}
            {t.lastVerified} <time datetime={lastVerified.toISOString()}>{formatDate(lastVerified, lang)}</time>{' '}
            <span class="ok">✓</span>
          </>
        )
      }
      {
        series && SERIES[series] && (
          <>
            {' · '}
            <a href={localePath(lang, `/series/${series}/`)}>{SERIES[series][lang]}</a>
          </>
        )
      }
    </div>

    {
      machineTranslated && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          {t.machineTranslated}
          {counterpart && (
            <>
              {' '}
              <a href={postUrl(counterpart)}>{t.readOriginal}</a>
            </>
          )}
        </p>
      )
    }
    {
      !machineTranslated && counterpart && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          <a href={postUrl(counterpart)} hreflang="ja">
            {t.readTranslation}
          </a>
        </p>
      )
    }
    {
      lastVerified && (
        <p class="notice warn" hidden data-stale-check={lastVerified.toISOString()}>
          <span class="lvl">[WARN]</span>
          {t.staleWarning}
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments lang={lang} />
</BaseLayout>

<script>
  // Staleness is judged against the reader's clock, not the build date,
  // so the warning still appears on a static page nobody has rebuilt for months.
  const STALE_AFTER_DAYS = 180;
  document.querySelectorAll<HTMLElement>('[data-stale-check]').forEach((el) => {
    const verified = new Date(el.dataset.staleCheck!).getTime();
    const ageDays = (Date.now() - verified) / 86_400_000;
    if (ageDays > STALE_AFTER_DAYS) el.hidden = false;
  });

  // ```mermaid blocks arrive as plain code; draw them in the browser.
  // The library is only fetched on pages that actually contain a diagram.
  const blocks = [...document.querySelectorAll<HTMLElement>('pre > code.language-mermaid')];
  if (blocks.length) {
    const scheme = window.matchMedia('(prefers-color-scheme: dark)');
    const css = getComputedStyle(document.documentElement);
    const color = (name: string) => css.getPropertyValue(name).trim();

    const diagrams = blocks.map((code) => {
      const figure = document.createElement('figure');
      figure.className = 'diagram';
      code.parentElement!.replaceWith(figure);
      return { figure, source: code.textContent ?? '' };
    });

    import('mermaid').then(async ({ default: mermaid }) => {
      const draw = async () => {
        // Colors come from the site's CSS variables so the diagrams follow light/dark.
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'base',
          flowchart: { wrappingWidth: 360 },
          themeVariables: {
            darkMode: scheme.matches,
            background: color('--panel'),
            fontFamily: css.getPropertyValue('--sans').trim(),
            primaryColor: color('--panel'),
            primaryTextColor: color('--bright'),
            primaryBorderColor: color('--amber'),
            lineColor: color('--muted'),
            secondaryColor: color('--panel'),
            tertiaryColor: color('--panel'),
            textColor: color('--fg'),
            edgeLabelBackground: color('--panel'),
            clusterBkg: color('--panel'),
            clusterBorder: color('--line'),
          },
        });
        for (const [i, { figure, source }] of diagrams.entries()) {
          try {
            const { svg } = await mermaid.render(`mermaid-${i}`, source);
            figure.innerHTML = svg;
          } catch (err) {
            // Keep the source readable if the syntax is wrong.
            console.error(err);
            const pre = document.createElement('pre');
            pre.textContent = source;
            figure.replaceChildren(pre);
          }
        }
      };
      await draw();
      scheme.addEventListener('change', draw);
    });
  }
</script>
