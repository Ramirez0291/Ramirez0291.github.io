---
import { render } from 'astro:content';
import katexCss from 'katex/dist/katex.min.css?url';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comments from '../../../components/Comments.astro';
import Toc from '../../../components/Toc.astro';
import ReadingRail from '../../../components/ReadingRail.astro';
import {
  findOriginal,
  findTranslations,
  formatDate,
  getAllPosts,
  HTML_LANG,
  localePath,
  PREFERRED_LANG_JS,
  postLang,
  postMarkdownUrl,
  postModified,
  postParams,
  postSlug,
  postUrl,
  SERIES,
  ui,
  type Lang,
  type Post,
} from '../../../i18n';
import { postSchema } from '../../../seo';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: postParams(post),
    props: { post, lang: postLang(post), translations: findTranslations(post, posts) },
  }));
}

const { post, lang, translations } = Astro.props as { post: Post; lang: Lang; translations: Post[] };
const t = ui[lang];
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, description, date, updated, lastVerified, machineTranslated, series, category, tags } = post.data;
const original = findOriginal(post, translations);

const alternates: Partial<Record<Lang, string>> = { [lang]: postUrl(post) };
for (const version of translations) alternates[postLang(version)] = postUrl(version);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
  article={{ published: date, modified: postModified(post), section: t.nav[category], tags }}
  schema={postSchema(post, translations)}
  markdown={postMarkdownUrl(post)}
>
  {remarkPluginFrontmatter.hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <article>
    <div class="cmd"><b>cat</b> {category}/{postSlug(post)}.md</div>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      {updated && <> · {t.updated} {formatDate(updated, lang)}</>}
      {
        lastVerified && (
          <>
            {' · '}
            {t.lastVerified} <time datetime={lastVerified.toISOString()}>{formatDate(lastVerified, lang)}</time>{' '}
            <span class="ok">✓</span>
          </>
        )
      }
      {
        series && SERIES[series] && (
          <>
            {' · '}
            <a href={localePath(lang, `/series/${series}/`)}>{SERIES[series][lang]}</a>
          </>
        )
      }
    </div>

    {
      machineTranslated && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          {t.machineTranslated}
          {original && (
            <>
              {' '}
              <a href={postUrl(original)} hreflang={HTML_LANG[postLang(original)]} data-pick-lang={postLang(original)}>
                {t.readOriginal}
              </a>
            </>
          )}
        </p>
      )
    }
    {
      !machineTranslated && translations.length > 0 && (
        <p class="notice">
          <span class="lvl">[INFO]</span>
          {translations.map((version, i) => (
            <>
              {i > 0 && ' · '}
              <a
                href={postUrl(version)}
                hreflang={HTML_LANG[postLang(version)]}
                lang={HTML_LANG[postLang(version)]}
                data-pick-lang={postLang(version)}
              >
                {ui[postLang(version)].readHere}
              </a>
            </>
          ))}
        </p>
      )
    }
    {
      /* Readers who land on a translation in a language their browser doesn't ask for
         (a shared link, a search result) are offered the version in their own language. */
      machineTranslated &&
        translations.map((version) => (
          <p class="notice" hidden data-offer-lang={postLang(version)} lang={HTML_LANG[postLang(version)]}>
            <span class="lvl">[INFO]</span>
            <a href={postUrl(version)} hreflang={HTML_LANG[postLang(version)]} data-pick-lang={postLang(version)}>
              {ui[postLang(version)].readHere}
            </a>
          </p>
        ))
    }
    {
      lastVerified && (
        <p class="notice warn" hidden data-stale-check={lastVerified.toISOString()}>
          <span class="lvl">[WARN]</span>
          {t.staleWarning}
        </p>
      )
    }

    <Toc lang={lang} headings={headings} file={`${postSlug(post)}.md`} />

    <div class="prose">
      <Content />
    </div>
  </article>
  <ReadingRail lang={lang} headings={headings} />
  <Comments lang={lang} />
  <script
    is:inline
    set:html={`(function () {
  var pref = (${PREFERRED_LANG_JS})();
  if (!pref || pref.lang === ${JSON.stringify(lang)}) return;
  var offer = document.querySelector('[data-offer-lang="' + pref.lang + '"]');
  if (offer) offer.hidden = false;
})();`}
  />
</BaseLayout>

<script>
  import '../../../scripts/mermaid';
</script>

<script>
  // Staleness is judged against the reader's clock, not the build date,
  // so the warning still appears on a static page nobody has rebuilt for months.
  const STALE_AFTER_DAYS = 180;
  document.querySelectorAll<HTMLElement>('[data-stale-check]').forEach((el) => {
    const verified = new Date(el.dataset.staleCheck!).getTime();
    const ageDays = (Date.now() - verified) / 86_400_000;
    if (ageDays > STALE_AFTER_DAYS) el.hidden = false;
  });
</script>
